# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Vercel Postgres connection string (with pool / sslmode)
# Provided automatically when connecting a Vercel Postgres store to the Next.js project.
DATABASE_URL="postgres://default:password@ep-sample-pool.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
